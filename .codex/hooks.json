{
  "description": "Codex lifecycle hooks for the Agentic Shopify App Pipeline. All 15 hooks live in .claude/hooks/ — one copy, registered by both .claude/settings.json and this file.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Loading pipeline dashboard"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/detect-gaps.sh\"",
            "timeout": 10,
            "statusMessage": "Checking pipeline gaps"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/guard-command.sh\"",
            "timeout": 10,
            "statusMessage": "Checking command safety"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/validate-commit.sh\"",
            "timeout": 15,
            "statusMessage": "Checking commit policy"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/validate-push.sh\"",
            "timeout": 10,
            "statusMessage": "Checking push policy"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/approval-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking gate approvals"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/app-store-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking App Store checklist"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$|^apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/validate-skill-frontmatter.sh\"",
            "timeout": 10,
            "statusMessage": "Validating skill and agent frontmatter"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/validate-skill-change.sh\"",
            "timeout": 5,
            "statusMessage": "Checking skill changes"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/track-request-changes.sh\"",
            "timeout": 5,
            "statusMessage": "Checking request-history tracking"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/notify.sh\"",
            "timeout": 10,
            "statusMessage": "Sending notification"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/pre-compact.sh\"",
            "timeout": 10,
            "statusMessage": "Saving pipeline state before compaction"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/post-compact.sh\"",
            "timeout": 10,
            "statusMessage": "Restoring pipeline context"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/session-stop.sh\"",
            "timeout": 10,
            "statusMessage": "Recording session summary"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/log-agent.sh\"",
            "timeout": 5,
            "statusMessage": "Recording subagent start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/log-agent-stop.sh\"",
            "timeout": 5,
            "statusMessage": "Recording subagent completion"
          }
        ]
      }
    ]
  }
}
